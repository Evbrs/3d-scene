# Configuration de service du frontend en production.
#
# nginx sert la SPA **et** relaie l'API : tout tient sur une seule origine. C'est ce qui permet à
# la CSP de se limiter à `connect-src 'self'`, au backend de ne rien publier sur l'extérieur, et
# au CORS de devenir sans objet.
#
# Le fichier est un gabarit : l'entrée de l'image nginx substitue les `${NGINX_*}` au démarrage
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) avant de le déposer dans conf.d. Les
# variables nginx sont écrites sans accolades — envsubst ne remplace que les formes `${...}` des
# noms retenus par NGINX_ENVSUBST_FILTER.

# Le proxy en amont a-t-il le droit de parler au nom d'un client ? La comparaison porte sur
# `$realip_remote_addr`, c'est-à-dire l'adresse du pair AVANT toute réécriture par `real_ip`.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${NGINX_TRUSTED_PROXY_NETWORK} 1;
}

# Schéma vu par le client. Un `X-Forwarded-Proto` n'est repris que s'il vient du réseau de
# confiance : sinon n'importe qui pourrait faire croire à l'application qu'elle est servie en
# HTTPS alors qu'elle ne l'est pas.
map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default   $scheme;
    "1:https" https;
    "1:http"  http;
}

# --- Limitation de débit de bordure -----------------------------------------------------------
#
# Défense en profondeur, et rien d'autre : le plafond qui fait foi est celui de l'application
# (`backend/app/core/rate_limit.py`), calibré route par route sur le coût processeur mesuré. Ces
# zones-ci sont volontairement plus larges — elles ne doivent jamais refuser une requête que
# l'application aurait acceptée. Leur rôle est de couper un flot **avant** qu'il n'atteigne
# uvicorn : une requête refusée ici ne consomme ni worker, ni connexion à la base, ni
# aller-retour Redis.
#
# `$binary_remote_addr` et non `$remote_addr` : quatre octets par entrée au lieu d'une chaîne,
# donc une zone qui tient bien plus d'adresses à taille égale. `real_ip` ayant déjà réécrit
# l'adresse au moment où la zone est consultée, c'est bien le visiteur qui est compté et non le
# terminateur TLS.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
# Les vues publiques n'exigent aucun compte et déclenchent un calcul de scène complet : c'est la
# seule surface qu'on peut marteler sans s'être jamais inscrit.
limit_req_zone $binary_remote_addr zone=public_api:5m rate=2r/s;

# Même code que l'application, pour qu'un client ne distingue pas les deux étages — et surtout
# pour qu'il retente selon la même règle. Le 503 par défaut se lit comme une panne du service.
limit_req_status 429;
limit_req_log_level warn;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Adresse réelle du visiteur. Sans elle, tout ce qui est en aval ne voit que l'IP du
    # conteneur de bordure : les limiteurs de débit du backend (connexion, vues publiques)
    # deviendraient un seau unique partagé par toute la plateforme — 60 connexions par tranche de
    # cinq minutes pour l'ensemble des utilisateurs, soit un déni de service auto-infligé.
    # On ne fait confiance qu'au réseau de la pile, jamais à un X-Forwarded-For venu d'ailleurs.
    set_real_ip_from ${NGINX_TRUSTED_PROXY_NETWORK};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Résolveur interne de Docker, interrogé à chaque requête (voir snippets/proxy-backend.conf).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # Un plan chargé (pièces, faces, ouvertures, revêtements) dépasse la limite par défaut de 1 Mo.
    client_max_body_size 10m;

    # Les erreurs nginx ne doivent pas révéler la version du serveur.
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Filet pour les réponses produites hors de toute `location` (requête malformée, par
    # exemple) : chaque bloc ci-dessous réinclut le fichier, faute d'héritage des `add_header`.
    include /etc/nginx/snippets/security-headers.conf;

    # --- API, relayée sur la même origine ---------------------------------------------------

    # Les vues publiques s'ouvrent sans authentification, sur simple jeton. Un jeton qui fuit une
    # fois — capture d'écran, historique de navigation, SMS transféré — ne doit pas rendre la
    # géométrie complète du logement d'un client indexable de façon permanente.
    location /api/public/ {
        # `nodelay` sert la rafale tout de suite au lieu de l'étaler : un visiteur qui ouvre le
        # lien partagé charge la page puis la scène, et lisser ces quelques requêtes se verrait
        # comme une lenteur. Au-delà de la rafale, la coupure est franche.
        limit_req zone=public_api burst=10 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location /api/ {
        # Rafale confortable : l'éditeur enregistre en lot puis relit la scène, et un artisan
        # derrière un partage de connexion ne doit jamais rencontrer ce plafond. Les routes
        # coûteuses sont plafonnées bien plus tôt par l'application elle-même.
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # Sonde de la pile complète : nginx joignable ET backend vivant.
    location = /health {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    # --- Application monopage ---------------------------------------------------------------

    # Page de partage. `try_files` sur un fichier existant sert la réponse depuis CE bloc, sans
    # redirection interne : la passer par `/index.html` la ferait traiter par le bloc
    # `location = /index.html`, qui n'a pas de X-Robots-Tag — et le lien partagé redeviendrait
    # indexable.
    location /partage/ {
        try_files /index.html =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
    }

    # Fichiers versionnés par empreinte : cachables indéfiniment.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # index.html ne doit jamais être mis en cache, sinon un déploiement reste invisible.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Toute route inconnue retombe sur index.html, sinon un rafraîchissement sur
    # /projets/12/plan donnerait un 404.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
