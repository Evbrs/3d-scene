# syntax=docker/dockerfile:1
# Image de production du frontend : build statique servi par nginx.
# L'image de développement (`Dockerfile`) fait tourner Vite avec le rechargement à chaud ; elle
# n'a rien à faire en production, où l'on veut des fichiers figés et aucun outil de build.

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# L'URL de l'API est figée à la compilation : Vite inline les variables `VITE_*`.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx écoute sur 8080 : un port non privilégié permet de tourner en non-root.
EXPOSE 8080
USER nginx
