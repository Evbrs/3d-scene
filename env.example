# Modèle de configuration locale.
# Copier ce fichier vers `.env` à la racine (`cp env.example .env`) et adapter les valeurs.
# `.env` est ignoré par Git — ne jamais y mettre de secret réel de production.
#
# Note : ce fichier ne s'appelle pas `.env.example` parce qu'un hook local interdit toute
# écriture sur un chemin contenant `.env`.

# --- Environnement ---
# `development` autorise la clé de signature par défaut. Toute autre valeur (production,
# staging…) impose une SECRET_KEY forte : le démarrage échoue sinon.
ENVIRONMENT=development

# Clé de signature des jetons JWT et des sessions du back-office.
# En production : au moins 32 caractères, générée aléatoirement, jamais commitée.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cle-de-developpement-a-remplacer-absolument-32+

# --- Postgres (consommé par docker-compose.yml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-en-local
POSTGRES_DB=app
# Ports hôte décalés : une installation PostgreSQL locale occupe souvent 5432 et masque le
# conteneur. En production, aucun de ces ports n'est publié.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Backend ---
DATABASE_URL=postgresql+psycopg://app:change-me-en-local@localhost:5433/app
REDIS_URL=redis://localhost:6380/0
DEBUG=true

# --- Frontend (préfixe VITE_ obligatoire pour être exposé au client) ---
# En développement, Vite et l'API sont sur deux origines distinctes, d'où l'URL absolue.
# En production c'est nginx qui relaie /api vers le backend : voir PUBLIC_API_URL plus bas.
VITE_API_BASE_URL=http://localhost:8000


# =================================================================================================
# Production — variables lues par docker-compose.prod.yml uniquement
# =================================================================================================

# Domaine public servi par la bordure TLS. Obligatoire pour que Caddy obtienne un certificat
# ACME ; sans lui, il émet un certificat local, utile seulement pour un essai.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile tls up -d
# PUBLIC_DOMAIN=plan.exemple.fr

# URL de l'API vue depuis le navigateur, figée dans le build du frontend.
# À LAISSER VIDE dans le cas nominal : le frontend et l'API partagent alors la même origine,
# ce qui referme d'un coup la directive `connect-src` de la CSP, le CORS, et l'exposition
# publique du port 8000. Attention, `/api` n'est PAS la bonne valeur : les chemins du client
# portent déjà ce préfixe, une base `/api` produirait des appels vers /api/api/...
# Ne renseigner que si l'API vit réellement sur un autre domaine — il faut alors aussi remplir
# CORS_ORIGINS et rouvrir `connect-src`.
# PUBLIC_API_URL=

# Origines autorisées à appeler l'API depuis un autre domaine. Vide en même origine.
# CORS_ORIGINS=https://plan.exemple.fr

# Interface sur laquelle le frontend est publié. La boucle locale par défaut : la bordure TLS
# joint nginx par le réseau Docker, pas par l'hôte. Ne passer à 0.0.0.0 que si un terminateur TLS
# externe est en amont — sinon n'importe qui sur le réseau de l'hôte pourrait forger un
# X-Forwarded-For et se faire passer pour une autre adresse auprès des limiteurs de débit.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_HOST_PORT=8080

# Plage d'adresses du réseau Docker de la pile. Cette valeur est le socle de la confiance
# accordée aux en-têtes X-Forwarded-* : elle est donnée telle quelle à nginx (`set_real_ip_from`),
# à uvicorn (`--forwarded-allow-ips`) et à TRUSTED_PROXIES ci-dessous. À changer si elle entre en
# conflit avec un réseau existant de l'hôte — le symptôme est un « Pool overlaps with other one »
# au démarrage.
# DOCKER_SUBNET=172.28.0.0/24


# =================================================================================================
# Réglages applicatifs — tous facultatifs, les défauts sont sûrs
# =================================================================================================

# Relais dont les en-têtes X-Forwarded-* font foi, en notation CIDR. Défaut `127.0.0.1,::1`, donc
# inerte derrière un relais : docker-compose.prod.yml le renseigne depuis DOCKER_SUBNET. Le joker
# `*` est refusé au démarrage — il permettrait à n'importe qui de se déclarer une autre adresse.
# TRUSTED_PROXIES=172.28.0.0/24

# Valeurs d'en-tête `Host` acceptées. Défaut `*`, c'est-à-dire protection inactive : tant qu'elle
# n'est pas renseignée, un `Host:` forgé peut faire fabriquer à l'application des liens vers le
# domaine d'un attaquant. localhost/127.0.0.1/::1 sont réinjectés d'office pour les sondes.
# ALLOWED_HOSTS=plan.exemple.fr

# Taille maximale du corps d'une requête, en octets. Défaut 10 Mio, aligné sur le
# `client_max_body_size` de nginx : les désaligner ferait refuser la requête deux fois, avec deux
# codes différents selon lequel des deux est atteint en premier.
# MAX_REQUEST_BODY_BYTES=10485760

# Clé de session du back-office. Vide (défaut) = dérivée de SECRET_KEY par blake2b à séparation de
# domaine : les deux secrets sont déjà cryptographiquement indépendants sans rien renseigner.
# ADMIN_SESSION_SECRET_KEY=

# Compteur de limitation de débit. Vide (défaut) = choix automatique : Redis hors développement,
# mémoire de processus en local. Ne le forcer à `memory` en production que sciemment — chaque
# worker aurait alors son propre seau, et la limite effective serait multipliée par quatre.
# RATE_LIMIT_BACKEND=redis

# Journalisation. `LOG_JSON=true` produit une ligne JSON par événement sur stdout, attendue par la
# plupart des collecteurs ; les adresses IP y sont anonymisées (/24 en IPv4, /48 en IPv6).
# LOG_LEVEL=INFO
# LOG_JSON=true

# Dimensionnement du pool de connexions, par processus (pool + débordement). Le total doit rester
# sous le `max_connections` de PostgreSQL : 4 workers x 10 + 2 Celery x 10 + 5 pour le back-office
# = 65, contre 100 par défaut côté serveur. Les défauts de SQLAlchemy (5 + 10) en réclamaient 105.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
